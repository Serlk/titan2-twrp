+// Gatekeeper verification of the synthetic password token through the AIDL Gatekeeper HAL, for
+// vendors that have no HIDL Gatekeeper 1.0 service (Android 14 vendors). Like gatekeeperd, the
+// HardwareAuthToken it returns goes to keystore2, which needs it to unwrap the spblob key.
+static bool Gatekeeper_Aidl_Verify(const userid_t user_id, const password_data_struct* pwd,
+                                   const unsigned char* password_token) {
+	namespace gk = ::aidl::android::hardware::gatekeeper;
+	::ndk::SpAIBinder binder(AServiceManager_checkService("android.hardware.gatekeeper.IGatekeeper/default"));
+	auto gk_device = gk::IGatekeeper::fromBinder(binder);
+	if (!gk_device) {
+		printf("failed to get gatekeeper service\n");
+		return false;
+	}
+	if (pwd->handle_len <= 0) {
+		printf("no password handle supplied\n");
+		return false;
+	}
+	void* gk_pwd_token = PersonalizedHashBinary(PERSONALIZATION_USER_GK_AUTH, (const char*)password_token, PASSWORD_TOKEN_SIZE);
+	if (!gk_pwd_token) {
+		printf("malloc error getting gatekeeper_key\n");
+		return false;
+	}
+	const uint8_t* handle = (const uint8_t*)pwd->password_handle;
+	std::vector<uint8_t> handle_vec(handle, handle + pwd->handle_len);
+	std::vector<uint8_t> token_vec((uint8_t*)gk_pwd_token, (uint8_t*)gk_pwd_token + SHA512_DIGEST_LENGTH);
+	free(gk_pwd_token);
+	gk::GatekeeperVerifyResponse rsp;
+	auto status = gk_device->verify(fakeUid(user_id), 0 /* challenge */, handle_vec, token_vec, &rsp);
+	if (!status.isOk()) {
+		if (status.getServiceSpecificError() == gk::IGatekeeper::ERROR_RETRY_TIMEOUT)
+			printf("GateKeeper response timeout\n");
+		else
+			printf("GateKeeper response error: %s\n", status.getDescription().c_str());
+		return false;
+	}
+	printf("GateKeeper status ok\n");
+	::ndk::SpAIBinder authz(AServiceManager_getService("android.security.authorization"));
+	auto service = ::aidl::android::security::authorization::IKeystoreAuthorization::fromBinder(authz);
+	if (!service) {
+		printf("error: could not connect to keystore service\n");
+		return false;
+	}
+	if (!service->addAuthToken(rsp.hardwareAuthToken).isOk()) {
+		printf("error: keystore did not take the auth token\n");
+		return false;
+	}
+	return true;
+}
