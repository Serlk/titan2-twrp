diff --git a/crypto/fde_removed.h b/crypto/fde_removed.h
new file mode 100644
index 0000000..97243e5
--- /dev/null
+++ b/crypto/fde_removed.h
@@ -0,0 +1,21 @@
+/*
+ * Full-disk encryption (FDE) is gone from the Android 14 vold that TWRP builds against, but a few
+ * TWRP code paths still call its functions. They are only reached on devices without a key
+ * directory (FDE); FBE devices never take them. These stand-ins report "no FDE".
+ */
+#ifndef TWRP_FDE_REMOVED_H
+#define TWRP_FDE_REMOVED_H
+
+#include <libdm/dm.h>
+
+static inline void set_partition_data(const char*, const char*) {}
+/* no FDE footer */
+static inline int cryptfs_check_footer() { return -1; }
+static inline int cryptfs_get_password_type() { return -1; }
+static inline int cryptfs_check_passwd(const char*) { return -1; }
+/* the dm device of a decrypted volume ("userdata" for metadata encryption) */
+static inline int delete_crypto_blk_dev(const char* name) {
+	return android::dm::DeviceMapper::Instance().DeleteDeviceIfExists(name) ? 0 : -1;
+}
+
+#endif
